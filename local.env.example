# Copy to local.env and fill in. local.env is git-ignored: your own names stay out of the repo.
# flash-mac.sh and setup.sh read it; flash-mac.sh copies it onto the card.

# The Pi's hostname: you reach it as <PI_HOST>.local. Default: simple-hifi.
PI_HOST=simple-hifi

# Name on the web page and on the phone's home screen. Default: Music.
PLAYER_TITLE="Music"

# Who the web page tells people to ask when a download fails. Default: the person who set up the player.
CONTACT_NAME=""

# The public address the Cloudflare Tunnel serves, if you set one up (a label only;
# the route itself is set in Cloudflare). Default: none.
PUBLIC_HOST=""
