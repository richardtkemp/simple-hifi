{
  "name": "PLAYER_TITLE",
  "short_name": "PLAYER_TITLE",
  "description": "Add YouTube songs to the music player",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ef5a47",
  "theme_color": "#ef5a47",
  "icons": [
    { "src": "/icon-3-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-3-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-3-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
